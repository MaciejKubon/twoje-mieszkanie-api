{
    "openapi": "3.0.0",
    "info": {
        "title": "Tytuł Twojego API - Twoje Mieszkanie",
        "description": "Dokumentacja API dla serwisu Twoje Mieszkanie",
        "version": "1.0.0"
    },
    "paths": {
        "/api/messages": {
            "get": {
                "tags": [
                    "Wiadomości"
                ],
                "summary": "Pobiera listę unikalnych partnerów konwersacji (rozmówców) zalogowanego użytkownika.",
                "operationId": "9d5effa2cb648df85be0ea9741ffb457",
                "responses": {
                    "200": {
                        "description": "Zwraca listę partnerów konwersacji.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message_list": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/User"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Błąd serwera."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/messages/{partner}": {
            "get": {
                "tags": [
                    "Wiadomości"
                ],
                "summary": "Pobiera historię wiadomości z konkretnym partnerem konwersacji.",
                "operationId": "fbcaaaca8e91a558f5d2ab11ac7c29ef",
                "parameters": [
                    {
                        "name": "partner",
                        "in": "path",
                        "description": "ID partnera konwersacji (obiekt User).",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Zwraca chronologiczną listę wiadomości.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Message"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Użytkownik (partner) nie znaleziony."
                    },
                    "500": {
                        "description": "Błąd serwera."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/messages/{receiver}": {
            "post": {
                "tags": [
                    "Wiadomości"
                ],
                "summary": "Wysyła nową wiadomość do określonego odbiorcy.",
                "operationId": "2d5ab6830dc3e332dbb975e9087e22cc",
                "parameters": [
                    {
                        "name": "receiver",
                        "in": "path",
                        "description": "ID użytkownika, do którego wysyłana jest wiadomość.",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "message"
                                ],
                                "properties": {
                                    "message": {
                                        "description": "Treść wiadomości (max 1000 znaków)",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Wiadomość została pomyślnie wysłana.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Wiadomość wysłana pomyślnie."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Błąd walidacji (np. brak pola 'message')."
                    },
                    "500": {
                        "description": "Błąd serwera."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/register": {
            "post": {
                "tags": [
                    "Użytkownik / Autoryzacja"
                ],
                "summary": "Rejestracja i utworzenie nowego użytkownika",
                "operationId": "2f25885f3b6f61ca11724ec302d2e439",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "first_name": {
                                        "type": "string",
                                        "example": "Jan"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "example": "Kowalski"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "jan.kowalski@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Haslo123!"
                                    },
                                    "confirm_password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Haslo123!"
                                    },
                                    "role": {
                                        "type": "string",
                                        "enum": [
                                            "admin",
                                            "owner",
                                            "rentier"
                                        ],
                                        "example": "owner"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Użytkownik zarejestrowany pomyślnie",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Użytkownik zarejestrowany pomyślnie!"
                                        },
                                        "user": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Nieprawidłowe dane rejestracji",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Nieprawidłowe dane rejestracji."
                                        },
                                        "error": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Użytkownik / Autoryzacja"
                ],
                "summary": "Logowanie użytkownika",
                "operationId": "0fc9610184083ac6dddab2c63139225a",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "jan.kowalski@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Haslo123!"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Logowanie powiodło się",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Logowanie powiodło się."
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "1|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Nieprawidłowe dane logowania",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Nieprawidłowe dane logowania."
                                        },
                                        "error": {
                                            "type": "string",
                                            "example": "Wprowadzony email lub hasło jest niepoprawne."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Użytkownik / Autoryzacja"
                ],
                "summary": "Wylogowanie użytkownika (wymaga tokenu)",
                "operationId": "67d5147477c548bfbc3f982833bbc7bd",
                "responses": {
                    "200": {
                        "description": "Wylogowano pomyślnie",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Wylogowano pomyślnie."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Brak autoryzacji (nie podano tokenu)"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/change-password": {
            "post": {
                "tags": [
                    "Użytkownik / Autoryzacja"
                ],
                "summary": "Zmiana hasła użytkownika (wymaga tokenu)",
                "operationId": "8bc73373376a79541c31827a055e46a5",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "current_password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "StareHaslo123!"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "NoweHaslo456!"
                                    },
                                    "confirm_password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "NoweHaslo456!"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Hasło zostało pomyślnie zaktualizowane",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Hasło zostało pomyślnie zaktualizowane!"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Nieprawidłowe dane (walidacja)"
                    },
                    "401": {
                        "description": "Brak autoryzacji lub obecne hasło jest niepoprawne"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "Message": {
                "title": "Message",
                "description": "Model wiadomości",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "from_user_id": {
                        "type": "integer",
                        "example": 3
                    },
                    "to_user_id": {
                        "type": "integer",
                        "example": 2
                    },
                    "message": {
                        "type": "string",
                        "example": "testowa wiadomość"
                    },
                    "sent_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-11-24 16:06:50"
                    },
                    "is_read": {
                        "type": "boolean",
                        "example": false
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-11-24 16:06:50"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-11-24 16:06:50"
                    }
                },
                "type": "object"
            },
            "User": {
                "title": "User",
                "description": "Model użytkownika",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Jan Kowalski"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "jan@example.com"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Uwierzytelnienie za pomocą tokena Bearer",
                "name": "bearerAuth",
                "in": "header",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Użytkownik / Autoryzacja",
            "description": "Operacje związane z kontem użytkownika i logowaniem."
        },
        {
            "name": "Wiadomości",
            "description": "Operacje związane z wiadomościami i konwersacjami."
        }
    ]
}