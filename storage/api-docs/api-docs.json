{
    "openapi": "3.0.0",
    "info": {
        "title": "Tytuł Twojego API - Twoje Mieszkanie",
        "description": "Dokumentacja API dla serwisu Twoje Mieszkanie",
        "version": "1.0.0"
    },
    "paths": {
        "/api/messages": {
            "get": {
                "tags": [
                    "Wiadomości"
                ],
                "summary": "Pobiera listę unikalnych partnerów konwersacji (rozmówców) zalogowanego użytkownika.",
                "operationId": "9d5effa2cb648df85be0ea9741ffb457",
                "responses": {
                    "200": {
                        "description": "Zwraca listę partnerów konwersacji.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message_list": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/User"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Błąd serwera."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/messages/{partner}": {
            "get": {
                "tags": [
                    "Wiadomości"
                ],
                "summary": "Pobiera historię wiadomości z konkretnym partnerem konwersacji.",
                "operationId": "fbcaaaca8e91a558f5d2ab11ac7c29ef",
                "parameters": [
                    {
                        "name": "partner",
                        "in": "path",
                        "description": "ID partnera konwersacji (obiekt User).",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Zwraca chronologiczną listę wiadomości.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Message"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Użytkownik (partner) nie znaleziony."
                    },
                    "500": {
                        "description": "Błąd serwera."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/messages/{receiver}": {
            "post": {
                "tags": [
                    "Wiadomości"
                ],
                "summary": "Wysyła nową wiadomość do określonego odbiorcy.",
                "operationId": "2d5ab6830dc3e332dbb975e9087e22cc",
                "parameters": [
                    {
                        "name": "receiver",
                        "in": "path",
                        "description": "ID użytkownika, do którego wysyłana jest wiadomość.",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "message"
                                ],
                                "properties": {
                                    "message": {
                                        "description": "Treść wiadomości (max 1000 znaków)",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Wiadomość została pomyślnie wysłana.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Wiadomość wysłana pomyślnie."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Błąd walidacji (np. brak pola \"message\")."
                    },
                    "500": {
                        "description": "Błąd serwera."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/objects": {
            "get": {
                "tags": [
                    "Obiekty"
                ],
                "summary": "Pobiera listę obiektów użytkownika",
                "operationId": "ba20d88cf540054dc4f5fb1d805fa9c9",
                "responses": {
                    "200": {
                        "description": "Zwraca listę obiektów",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "objects": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Objects"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Błąd serwera."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Obiekty"
                ],
                "summary": "Tworzy nowy obiekt",
                "operationId": "d8e0a3cece83bec05348296ec777ea7e",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "type_of_building",
                                    "country",
                                    "voivodeship",
                                    "city",
                                    "zip_code",
                                    "street",
                                    "house_number"
                                ],
                                "properties": {
                                    "type_of_building": {
                                        "type": "string",
                                        "enum": [
                                            "house",
                                            "apartment",
                                            "room"
                                        ]
                                    },
                                    "country": {
                                        "type": "string",
                                        "example": "Polska"
                                    },
                                    "voivodeship": {
                                        "type": "string",
                                        "example": "Mazowieckie"
                                    },
                                    "city": {
                                        "type": "string",
                                        "example": "Warszawa"
                                    },
                                    "zip_code": {
                                        "type": "string",
                                        "example": "00-001"
                                    },
                                    "street": {
                                        "type": "string",
                                        "example": "Wiejska"
                                    },
                                    "house_number": {
                                        "type": "string",
                                        "example": "10"
                                    },
                                    "apartment_number": {
                                        "type": "string",
                                        "example": "5",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Obiekt został dodany"
                    },
                    "400": {
                        "description": "Błąd walidacji"
                    },
                    "403": {
                        "description": "Brak uprawnień"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/objects/{id}": {
            "get": {
                "tags": [
                    "Obiekty"
                ],
                "summary": "Wyświetla szczegóły konkretnego obiektu",
                "operationId": "8df8847939b0656f997f966747759bc4",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Szczegóły obiektu"
                    },
                    "404": {
                        "description": "Obiekt nie został znaleziony"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Obiekty"
                ],
                "summary": "Aktualizuje istniejący obiekt",
                "operationId": "e0ba2519853daa4cd976a5b74b89caf3",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "type_of_building": {
                                        "type": "string",
                                        "enum": [
                                            "house",
                                            "apartment",
                                            "room"
                                        ]
                                    },
                                    "country": {
                                        "type": "string"
                                    },
                                    "city": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Obiekt został zaktualizowany"
                    },
                    "403": {
                        "description": "Brak dostępu"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Obiekty"
                ],
                "summary": "Usuwa obiekt",
                "operationId": "048b3a4a891f020e1593da0551dcfefa",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Obiekt został usunięty"
                    },
                    "403": {
                        "description": "Brak dostępu"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/register": {
            "post": {
                "tags": [
                    "Użytkownik / Autoryzacja"
                ],
                "summary": "Rejestracja i utworzenie nowego użytkownika",
                "operationId": "2f25885f3b6f61ca11724ec302d2e439",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "first_name",
                                    "last_name",
                                    "email",
                                    "password",
                                    "confirm_password",
                                    "role"
                                ],
                                "properties": {
                                    "first_name": {
                                        "type": "string",
                                        "example": "Jan"
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "example": "Kowalski"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "jan.kowalski@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Haslo123!"
                                    },
                                    "confirm_password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Haslo123!"
                                    },
                                    "role": {
                                        "type": "string",
                                        "enum": [
                                            "admin",
                                            "owner",
                                            "rentier"
                                        ],
                                        "example": "owner"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Użytkownik zarejestrowany pomyślnie",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Użytkownik zarejestrowany pomyślnie!"
                                        },
                                        "user": {
                                            "$ref": "#/components/schemas/User"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Nieprawidłowe dane rejestracji",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Nieprawidłowe dane rejestracji."
                                        },
                                        "error": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Użytkownik / Autoryzacja"
                ],
                "summary": "Logowanie użytkownika",
                "operationId": "0fc9610184083ac6dddab2c63139225a",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "jan.kowalski@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Haslo123!"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Logowanie powiodło się",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Logowanie powiodło się."
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "1|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                                        },
                                        "user": {
                                            "$ref": "#/components/schemas/User"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Nieprawidłowe dane logowania",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Nieprawidłowe dane logowania."
                                        },
                                        "error": {
                                            "type": "string",
                                            "example": "Wprowadzony email lub hasło jest niepoprawne."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Użytkownik / Autoryzacja"
                ],
                "summary": "Wylogowanie użytkownika (wymaga tokenu)",
                "operationId": "67d5147477c548bfbc3f982833bbc7bd",
                "responses": {
                    "200": {
                        "description": "Wylogowano pomyślnie",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Wylogowano pomyślnie."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Brak autoryzacji (nie podano tokenu)"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/change-password": {
            "post": {
                "tags": [
                    "Użytkownik / Autoryzacja"
                ],
                "summary": "Zmiana hasła użytkownika (wymaga tokenu)",
                "operationId": "8bc73373376a79541c31827a055e46a5",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "current_password",
                                    "password",
                                    "confirm_password"
                                ],
                                "properties": {
                                    "current_password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "StareHaslo123!"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "NoweHaslo456!"
                                    },
                                    "confirm_password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "NoweHaslo456!"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Hasło zostało pomyślnie zaktualizowane",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Hasło zostało pomyślnie zaktualizowane!"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Nieprawidłowe dane (walidacja)"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "Message": {
                "title": "Message",
                "description": "Message model",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "from_user_id": {
                        "type": "integer",
                        "example": 3
                    },
                    "to_user_id": {
                        "type": "integer",
                        "example": 2
                    },
                    "message": {
                        "type": "string",
                        "example": "testowa wiadomość"
                    },
                    "sent_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-11-24 16:06:50"
                    },
                    "is_read": {
                        "type": "boolean",
                        "example": false
                    }
                },
                "type": "object"
            },
            "Objects": {
                "title": "Obiekty",
                "description": "Struktura danych obiektu nieruchomości",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "id_owner": {
                        "type": "integer",
                        "example": 5
                    },
                    "type_of_building": {
                        "type": "string",
                        "enum": [
                            "house",
                            "apartment",
                            "room"
                        ],
                        "example": "apartment"
                    },
                    "country": {
                        "type": "string",
                        "example": "Polska"
                    },
                    "voivodeship": {
                        "type": "string",
                        "example": "Mazowieckie"
                    },
                    "city": {
                        "type": "string",
                        "example": "Warszawa"
                    },
                    "zip_code": {
                        "type": "string",
                        "example": "00-001"
                    },
                    "street": {
                        "type": "string",
                        "example": "Wiejska"
                    },
                    "house_number": {
                        "type": "string",
                        "example": "10"
                    },
                    "apartment_number": {
                        "type": "string",
                        "example": "5",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "User": {
                "title": "User",
                "description": "Model użytkownika",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Jan Kowalski"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "jan@example.com"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Uwierzytelnienie za pomocą tokena Bearer",
                "name": "bearerAuth",
                "in": "header",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Użytkownik / Autoryzacja",
            "description": "Operacje związane z kontem użytkownika i logowaniem."
        },
        {
            "name": "Obiekty",
            "description": "Operacje związane z zarządzaniem nieruchomościami."
        },
        {
            "name": "Wiadomości",
            "description": "Operacje związane z wiadomościami i konwersacjami."
        }
    ]
}